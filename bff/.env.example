PORT=3000
# Se ficar vazio, o BFF gera um segredo aleatório na primeira execução e salva no .env
JWT_SECRET=
JWT_EXPIRES_IN=8h
DB_FILE=barbearia.db
# Origens de navegador autorizadas (separadas por vírgula). O app no celular não precisa estar aqui.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
ABERTURA=08:00
FECHAMENTO=20:00
